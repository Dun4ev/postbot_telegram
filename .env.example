# --- Telegram Config ---
TG_BOT_TOKEN=your_bot_token_here
TG_CHANNEL=@your_channel_name
# TG_CHANNEL_ID=-100... (alternative)

# --- X (Twitter) Config ---
X_ENABLED=0
X_API_KEY=        # На портале: Consumer Key
X_API_SECRET=     # На портале: Consumer Secret
X_ACCESS_TOKEN=   # На портале: Access Token (генерируется отдельно)
X_ACCESS_TOKEN_SECRET= # На портале: Access Token Secret
X_BEARER_TOKEN=   # На портале: Bearer Token

# --- Bot Behavior ---
TZ=Europe/Belgrade
POST_SLOTS=10:00,13:00,16:00,19:00,22:00
# Папка для скачивания медиа
POSTBOT_STORAGE_DIR=storage
# Глобальная подпись (поддерживает HTML)
POSTBOT_SIGNATURE="\n\nJoin our channel: https://t.me/example\n#tag"

# --- Logging ---
POSTBOT_LOG_LEVEL=INFO
POSTBOT_LOG_FILE=postbot.log
