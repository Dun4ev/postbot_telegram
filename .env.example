# --- Telegram Config ---
TG_BOT_TOKEN=your_bot_token_here
TG_CHANNEL=@your_channel_name
# TG_CHANNEL_ID=-100... (alternative)

# --- X (Twitter) Config ---
X_ENABLED=0
X_API_KEY=        # На портале: Consumer Key
X_API_SECRET=     # На портале: Consumer Secret
X_ACCESS_TOKEN=   # На портале: Access Token (генерируется отдельно)
X_ACCESS_TOKEN_SECRET= # На портале: Access Token Secret
X_BEARER_TOKEN=   # На портале: Bearer Token
POSTBOT_SIGNATURE="\n\n✨ Join our private channel: https://t.me/+BFaD3NqIEARiZmZi\n#peach #juicy #exclusive"

# --- Bot Behavior ---
TZ=Europe/Belgrade
POST_SLOTS=10:00,13:00,16:00,19:00,22:00
# Папка для скачивания медиа
POSTBOT_STORAGE_DIR=storage
POSTBOT_DB_PATH=queue.db
# --- Optional AI captions for Telegram and X.com ---
POSTBOT_AI_CAPTION=0
POSTBOT_AI_ENDPOINT=https://api.mistral.ai/v1/chat/completions
POSTBOT_AI_API_KEY=
POSTBOT_AI_MODEL=magistral-small-2509
POSTBOT_AI_LANGUAGE=English
POSTBOT_AI_STYLE=Short intriguing captions for a private lifestyle channel of a confident beautiful girl. Positive flirtation, light mystery, warmth, and an invitation to chat. Add 1-3 soft emojis like smiles, hearts, sparkles, or peach. No explicit promises, links, or hashtags. Mood examples: "what do you think? 💕", "do you like this pose? 🍑", "come chat with me 😉", "write me ✨".
POSTBOT_AI_TIMEOUT=8
POSTBOT_AI_MAX_CHARS=120
POSTBOT_FILL_CAPTIONS_LIMIT=10
POSTBOT_FILL_CAPTIONS_DELAY=60
POSTBOT_FILL_CAPTIONS_RATE_LIMIT_SLEEP=1800

# --- Logging ---
POSTBOT_LOG_LEVEL=INFO
POSTBOT_LOG_FILE=postbot.log
